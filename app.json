{
  "expo": {
    "name": "CampusCapsule",
    "slug": "campuscapsule",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "campuscapsule",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.campuscapsule.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1B22"
      },
      "package": "com.campuscapsule.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "CampusCapsule needs access to your gallery so you can share your daily university memory.",
          "cameraPermission": "CampusCapsule needs camera access so you can capture real-time moments with your friends."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CampusCapsule uses your location to tag campus landmarks and hangout spots on your memories."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "30df299d-d55a-4850-b3e4-19a8bfa68124"
      }
    }
  }
}
